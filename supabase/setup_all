  if tg_op = 'UPDATE' then
    if tg_table_name = 'freelancer_profiles'
       and v_new -> 'approval_status' is not distinct from v_old -> 'approval_status'
       and v_new -> 'identity_verified' is not distinct from v_old -> 'identity_verified' then
