    case tg_table_name when 'freelancer_profiles' then 'user_id' when 'platform_settings' then 'key'
                       when 'user_roles' then 'user_id' else 'id' end);

  insert into public.audit_logs (actor_id, action, entity, entity_id, old_data, new_data)
  values (auth.uid(), lower(tg_op), tg_table_name, v_id, v_old, v_new);
  return null;
end $$;

