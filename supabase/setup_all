      new.is_featured := false; new.moderation_notes := null;
      if new.status = 'suspenso' then new.status := 'rascunho'; end if;
    end if;
    if new.status = 'publicado' then
      raise exception 'Cadastre ao menos o pacote Básico antes de publicar o serviço.' using errcode = 'P0001';
    end if;
    return new;
  end if;

